DATABASE_URL=postgresql://<db-user>:<db-password>@<db-host>:5432/final_ims_build
DATABASE_URL_SECRET_NAME=POS_DATABASE_URL
# T1b bootstrap role (app_bootstrap) — SELECT-only on users + pos_terminals,
# used solely for the terminal-token scan. Optional. Provisioned/owned by
# ims-1's scripts/provision-bootstrap-role.ts.
BOOTSTRAP_DATABASE_URL=postgresql://app_bootstrap:<password>@<db-host>:5432/final_ims_build
# T1b runtime role (app_runtime) — non-owner, no BYPASSRLS. Every
# terminal-authenticated request runs on this connection so RLS applies.
RUNTIME_DATABASE_URL=postgresql://app_runtime:<password>@<db-host>:5432/final_ims_build
NODE_ENV=development
HOST=127.0.0.1
SHOP_TIMEZONE=Asia/Kolkata

GCP_PROJECT_ID=<gcp-project-id>
GCP_SECRET_MANAGER_ENABLED=false

CORS_ALLOWED_ORIGINS=http://localhost:5173
TERMINAL_AUTH_CACHE_TTL_SECONDS=60
GLOBAL_RATE_LIMIT_MAX_REQUESTS=120
GLOBAL_RATE_LIMIT_WINDOW_SECONDS=60
CASHIER_PIN_MAX_FAILURES=5
CASHIER_PIN_WINDOW_SECONDS=300
OWNER_OVERRIDE_MAX_FAILURES=5
OWNER_OVERRIDE_WINDOW_SECONDS=300
OVERRIDE_DISCOUNT_PERCENT_THRESHOLD=25
POS_OWNER_SESSION_SECRET=<generate-with-openssl-rand-base64-32>

RAZORPAY_LIVE_ENABLED=false
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_TIMEOUT_MS=5000

EMAIL_LIVE_ENABLED=false
EMAIL_API_KEY=<email-api-key>
EMAIL_FROM_ADDRESS=receipts@example.com
EMAIL_PROVIDER_BASE_URL=https://api.resend.com
EMAIL_TIMEOUT_MS=5000
