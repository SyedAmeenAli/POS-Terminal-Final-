{
  "name": "pos-terminal",
  "version": "1.0.0",
  "description": "Standalone POS terminal backend sharing the IMS-owned database.",
  "main": "dist/src/index.js",
  "scripts": {
    "check:pos-web-csp": "tsx scripts/check-pos-web-csp.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "verify:restore": "tsx scripts/verify-restore.ts",
    "build": "tsc -p tsconfig.json",
    "db:generate": "echo 'Schema is owned by the ims-1 repo. Run migrations there.' && exit 1",
    "db:migrate": "echo 'Schema is owned by the ims-1 repo. Run migrations there.' && exit 1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.7.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.7.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@google-cloud/secret-manager": "^6.2.0",
    "argon2": "^0.45.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
